# Copia este archivo como .env para desarrollo local con Supabase
# y configura estas mismas variables en Vercel -> Project Settings -> Environment Variables

SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=.vercel.app,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# PostgreSQL de Supabase (usa Session Pooler o Transaction Pooler para soporte IPv4 en Vercel)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase Storage (para persistir justificativos y autorizaciones fuera del disco efímero de Vercel)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada
SUPABASE_BUCKET=huachipato-media
